# MRBrain Final Environment Configuration
# These variables configure the MRBrain_final integration

# Path configurations
MRBRAIN_FINAL_PATH=/app/MRBrain_final
MRBRAIN_API_URL=http://mrbrain-api:8000

# API configurations
MRBRAIN_API_HOST=0.0.0.0
MRBRAIN_API_PORT=8000

# Processing configurations
PROCESSING_TIMEOUT=1800
MAX_FILE_SIZE_MB=100
TEMP_DIR=/tmp

# Age validation
MIN_AGE=18
MAX_AGE=95

# Logging
LOG_LEVEL=INFO
ENABLE_DEBUG=false

# Model configurations (optional - will use defaults if not specified)
# BRAINAGE_MODEL_PATH=/app/MRBrain_final/BrainAge-Prediction/saved_models/brain_age_pipeline.pkl
# NORMATIVE_MODELS_PATH=/app/MRBrain_final/Normative Modeling/Models